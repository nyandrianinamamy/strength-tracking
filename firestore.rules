rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function allowedEmailPath() {
      return /databases/$(database)/documents/allowedEmails/$(request.auth.token.email);
    }

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && exists(allowedEmailPath())
        && get(allowedEmailPath()).data.enabled == true;
    }

    match /allowedEmails/{email} {
      allow get: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isAllowedUser() && request.auth.uid == userId;
    }
  }
}
