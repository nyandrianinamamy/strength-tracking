#!/bin/sh
# Auto-increment build number in pubspec.yaml after each commit
# The bumped version is staged and included in the NEXT commit
# (not the current one, to avoid amend loops)

PUBSPEC="pubspec.yaml"
LOCK_FILE="/tmp/.git-post-commit-lock"

# Prevent recursive execution
if [ -f "$LOCK_FILE" ]; then
  exit 0
fi

if [ ! -f "$PUBSPEC" ]; then
  exit 0
fi

# Extract current version line
CURRENT=$(grep '^version:' "$PUBSPEC")
if [ -z "$CURRENT" ]; then
  exit 0
fi

# Parse build number
BUILD=$(echo "$CURRENT" | sed 's/.*+//')
NEW_BUILD=$((BUILD + 1))

# Replace in pubspec
VERSION_BASE=$(echo "$CURRENT" | sed 's/+.*//')
NEW_VERSION="${VERSION_BASE}+${NEW_BUILD}"

# Use platform-appropriate sed
if [ "$(uname)" = "Darwin" ]; then
  sed -i '' "s/^version:.*/$NEW_VERSION/" "$PUBSPEC"
else
  sed -i "s/^version:.*/$NEW_VERSION/" "$PUBSPEC"
fi

# Create lock, amend commit, remove lock
touch "$LOCK_FILE"
git add "$PUBSPEC"
git commit --amend --no-edit --no-verify > /dev/null 2>&1
rm -f "$LOCK_FILE"
