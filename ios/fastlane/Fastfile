default_platform(:ios)

def app_store_connect_api_key_from_env
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY"],
    is_key_content_base64: true,
  )
end

def ensure_bundle_capability(app_identifier, capability_type)
  bundle_id = Spaceship::ConnectAPI::BundleId.find(app_identifier)
  UI.user_error!("Bundle ID #{app_identifier} was not found") unless bundle_id

  capabilities = Spaceship::ConnectAPI::BundleIdCapability.all(
    bundle_id_id: bundle_id.id,
  )

  if capabilities.any? { |capability| capability.is_type?(capability_type) }
    UI.message("#{app_identifier} already has #{capability_type}")
    return
  end

  UI.message("Enabling #{capability_type} for #{app_identifier}")
  Spaceship::ConnectAPI::BundleIdCapability.create(
    bundle_id_id: bundle_id.id,
    capability_type: capability_type,
  )
end

def bundle_capability_enabled?(app_identifier, capability_type)
  bundle_id = Spaceship::ConnectAPI::BundleId.find(app_identifier)
  UI.user_error!("Bundle ID #{app_identifier} was not found") unless bundle_id

  capabilities = Spaceship::ConnectAPI::BundleIdCapability.all(
    bundle_id_id: bundle_id.id,
  )

  capabilities.any? { |capability| capability.is_type?(capability_type) }
end

platform :ios do
  desc "Read-only check that Sign in with Apple is enabled on the main bundle ID"
  lane :check_apple_sign_in_capability do
    app_store_connect_api_key_from_env

    app_identifier = "dev.mamy-r.kotrana"
    capability_type = Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH

    if bundle_capability_enabled?(app_identifier, capability_type)
      UI.success("#{app_identifier} has #{capability_type} enabled")
    else
      UI.user_error!("#{app_identifier} is missing #{capability_type}; enable Sign in with Apple in Apple Developer before rerunning Build iOS")
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    # Authenticate with App Store Connect API
    api_key = app_store_connect_api_key_from_env

    ensure_bundle_capability(
      "dev.mamy-r.kotrana",
      Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH,
    )

    # Fetch signing certificates and profiles
    match(
      type: "appstore",
      readonly: false,
      force: true,
      api_key: api_key,
    )

    # Switch all targets to manual signing for CI
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "6B673XM2ST",
      code_sign_identity: "iPhone Distribution",
      targets: ["Runner"],
      profile_name: "match AppStore dev.mamy-r.kotrana",
      bundle_identifier: "dev.mamy-r.kotrana",
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "6B673XM2ST",
      code_sign_identity: "iPhone Distribution",
      targets: ["StrengthAppLiveActivity"],
      profile_name: "match AppStore dev.mamy-r.kotrana.liveactivity",
      bundle_identifier: "dev.mamy-r.kotrana.liveactivity",
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "6B673XM2ST",
      code_sign_identity: "Apple Distribution",
      targets: ["StrengthAppWatch Watch App"],
      profile_name: "match AppStore dev.mamy-r.kotrana.watchkitapp",
      bundle_identifier: "dev.mamy-r.kotrana.watchkitapp",
    )

    # Override this archive's Flutter version without replacing source plist
    # placeholders, so subsequent local builds still follow pubspec.yaml.
    version_settings = {
      "FLUTTER_BUILD_NAME" => ENV["BUILD_VERSION"],
      "FLUTTER_BUILD_NUMBER" => ENV["BUILD_NUMBER"],
    }.compact

    # Build the Xcode archive with proper signing
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      xcargs: version_settings,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "dev.mamy-r.kotrana" => "match AppStore dev.mamy-r.kotrana",
          "dev.mamy-r.kotrana.liveactivity" => "match AppStore dev.mamy-r.kotrana.liveactivity",
          "dev.mamy-r.kotrana.watchkitapp" => "match AppStore dev.mamy-r.kotrana.watchkitapp",
        },
      },
      output_directory: "../build/ios/ipa",
      output_name: "Kotrana.ipa",
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "../build/ios/ipa/Kotrana.ipa",
    )
  end

  desc "Sync App Store Connect metadata without uploading a build or submitting"
  lane :metadata do
    setup_ci if ENV["CI"]

    demo_password = ENV["APP_REVIEW_DEMO_PASSWORD"].to_s
    UI.user_error!("APP_REVIEW_DEMO_PASSWORD is required to upload reviewer sign-in details") if demo_password.empty?

    upload_screenshots = ENV["UPLOAD_SCREENSHOTS"].to_s.downcase == "true"

    deliver(
      api_key: app_store_connect_api_key_from_env,
      app_identifier: "dev.mamy-r.kotrana",
      app_version: ENV["APP_STORE_VERSION"] || ENV["BUILD_VERSION"] || "1.0",
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      skip_screenshots: !upload_screenshots,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: {
        demo_password: demo_password,
      },
    )
  end
end
