default_platform(:ios)

def ensure_bundle_capability(app_identifier, capability_type)
  bundle_id = Spaceship::ConnectAPI::BundleId.find(app_identifier)
  UI.user_error!("Bundle ID #{app_identifier} was not found") unless bundle_id

  capabilities = Spaceship::ConnectAPI::BundleIdCapability.all(
    bundle_id_id: bundle_id.id,
  )

  if capabilities.any? { |capability| capability.is_type?(capability_type) }
    UI.message("#{app_identifier} already has #{capability_type}")
    return
  end

  UI.message("Enabling #{capability_type} for #{app_identifier}")
  Spaceship::ConnectAPI::BundleIdCapability.create(
    bundle_id_id: bundle_id.id,
    capability_type: capability_type,
  )
end

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    # Authenticate with App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
    )

    ensure_bundle_capability(
      "dev.mamy-r.kotrana",
      Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH,
    )

    # Fetch signing certificates and profiles
    match(
      type: "appstore",
      readonly: false,
      force: true,
      api_key: api_key,
    )

    # Switch all targets to manual signing for CI
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "6B673XM2ST",
      code_sign_identity: "iPhone Distribution",
      targets: ["Runner"],
      profile_name: "match AppStore dev.mamy-r.kotrana",
      bundle_identifier: "dev.mamy-r.kotrana",
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "6B673XM2ST",
      code_sign_identity: "iPhone Distribution",
      targets: ["StrengthAppLiveActivity"],
      profile_name: "match AppStore dev.mamy-r.kotrana.liveactivity",
      bundle_identifier: "dev.mamy-r.kotrana.liveactivity",
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "6B673XM2ST",
      code_sign_identity: "Apple Distribution",
      targets: ["StrengthAppWatch Watch App"],
      profile_name: "match AppStore dev.mamy-r.kotrana.watchkitapp",
      bundle_identifier: "dev.mamy-r.kotrana.watchkitapp",
    )

    # Set version from tag (CI passes BUILD_VERSION env var)
    if ENV["BUILD_VERSION"]
      increment_version_number(
        version_number: ENV["BUILD_VERSION"],
        xcodeproj: "Runner.xcodeproj",
      )
    end

    # Build the Xcode archive with proper signing
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "dev.mamy-r.kotrana" => "match AppStore dev.mamy-r.kotrana",
          "dev.mamy-r.kotrana.liveactivity" => "match AppStore dev.mamy-r.kotrana.liveactivity",
          "dev.mamy-r.kotrana.watchkitapp" => "match AppStore dev.mamy-r.kotrana.watchkitapp",
        },
      },
      output_directory: "../build/ios/ipa",
      output_name: "Kotrana.ipa",
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "../build/ios/ipa/Kotrana.ipa",
    )
  end
end
