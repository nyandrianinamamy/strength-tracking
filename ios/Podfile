# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  pod 'FirebaseFirestore',
    :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git',
    :tag => '11.15.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Match the existing iOS 15 application floor for dependency targets that
    # declare an older minimum. Preserve higher requirements and watchOS.
    target.build_configurations.each do |config|
      minimum = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if minimum && minimum.match?(/\A\d+(\.\d+)*\z/) && Gem::Version.new(minimum) < Gem::Version.new('15.0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    # Xcode 26 beta: device_info_plus 12.4.0 calls [NSProcessInfo isiOSAppOnVision]
    # which doesn't exist in this SDK yet. Patch the source to use respondsToSelector.
    # Safe to remove once device_info_plus ships a compatible release.
    if target.name == 'device_info_plus'
      source_file = File.join(installer.sandbox.pod_dir('device_info_plus'),
        'ios', 'device_info_plus', 'Sources', 'device_info_plus', 'FPPDeviceInfoPlusPlugin.m')
      if File.exist?(source_file)
        content = File.read(source_file)
        if content.include?('isiOSAppOnVision')
          patched = content.gsub(
            /if \(@available\(iOS 26\.1, \*\)\) \{\s*isiOSAppOnVision = \[NSNumber numberWithBool:\[info isiOSAppOnVision\]\];\s*\}/,
            'if ([info respondsToSelector:@selector(isiOSAppOnVision)]) { isiOSAppOnVision = [NSNumber numberWithBool:((BOOL (*)(id, SEL))objc_msgSend)(info, @selector(isiOSAppOnVision))]; }'
          )
          File.write(source_file, patched) if patched != content
        end
      end
    end
  end
end
